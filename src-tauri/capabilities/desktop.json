{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only (Card 192): main + native float windows. Multi-window permissions never ship to Android / iOS. Card 228: the shared ⋯ popup window ('menu') places itself on the trigger's monitor (monitor/position/scale reads, also in core:window:default).",
  "windows": [
    "*"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-always-on-bottom",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-shadow",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-decorations",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "core:window:allow-current-monitor",
    "core:window:allow-monitor-from-point",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-scale-factor",
    "core:window:allow-is-focused"
  ]
}
